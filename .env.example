# ---------------------------------------------------------------- Model backend
#
# Defaults to OpenAI.  Any LangChain chat backend works -- see docs/PROVIDERS.md
# for the full list and the two ways in.  The OPENAI_* names further down still
# work, so an existing .env needs no edit.

# Which backend.  'openai' means the OpenAI *wire format*, not the vendor: leave
# it here and set LLM_BASE_URL to use any OpenAI-compatible endpoint (a company
# gateway, vLLM, llama.cpp's server, LM Studio, LocalAI, Ollama's /v1 port).
# For a native integration use anthropic | google_genai | ollama | azure_openai |
# bedrock | ... and install its package, e.g.  pip install '.[anthropic]'
LLM_PROVIDER=

# Endpoint override.  Setting this is what makes the client talk to something
# other than api.openai.com.  Leave blank for OpenAI itself.
LLM_BASE_URL=

# Key and model.  LLM_* wins over OPENAI_* when both are set.
LLM_API_KEY=
LLM_MODEL=

# Reasoning/thinking effort: minimal | low | medium | high.  One setting for all
# backends -- each provider translates it (OpenAI reasoning effort, Anthropic
# thinking budget, and so on).  Blank means the provider default.
LLM_EFFORT=

# OpenAI wire dialect: responses | chat.  Blank auto-selects, which is almost
# always right: OpenAI itself gets 'responses' (needed for a reasoning model to
# reason *and* call tools), and anything with LLM_BASE_URL set gets 'chat',
# because nearly nothing but OpenAI implements /v1/responses.  Set it only to
# override that.
LLM_API=

# Extra kwargs for the backend, as JSON, merged last.  The escape hatch for a
# provider option this client does not model, e.g. {"num_predict": 512}
LLM_EXTRA=

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
# Default is GPT-5.6 Sol (reasoning model, strongest vision + agentic tier).
# Confirm the exact model id in your OpenAI dashboard and change it if needed.
OPENAI_MODEL=gpt-5.6-sol
# Legacy name for LLM_EFFORT (minimal|low|medium|high).
OPENAI_REASONING_EFFORT=
# Only used for non-reasoning chat models (e.g. gpt-4o); ignored otherwise.
OPENAI_TEMPERATURE=0

# BRL-CAD Socket Bridge
BRLCAD_HOST=127.0.0.1
BRLCAD_PORT=5555
BRLCAD_TIMEOUT=5.0
BRLCAD_BUFFER_SIZE=4096

# MCP Server
MCP_TRANSPORT=stdio

# client-v2: set true to stream a per-node agent trace (routing, model turns,
# tool calls, tool results) instead of only the final answer.
CLIENT_V2_DEBUG=false

# Rendering (render_model tool). Renders run entirely over the socket via the
# ged 'rt' command, so no BRL-CAD binaries or PATH are needed.
# BRLCAD_RENDER_DIR: where rendered PNGs are written (default ~/brlcad_renders).
# BRLCAD_RENDER_TIMEOUT: seconds to wait for one render (default 1800). Raise it
#   for slow renders -- large models, high ambSamples, or photon mapping.
BRLCAD_RENDER_DIR=
BRLCAD_RENDER_TIMEOUT=

# Restore points saved before a raw destructive command (kill/killall/mv/...),
# rolled back with restore_backup. Default ~/brlcad_backups -- deliberately NOT
# under BRLCAD_RENDER_DIR, so clearing a render cache cannot delete the only way
# back from a bad edit.
BRLCAD_BACKUP_DIR=
