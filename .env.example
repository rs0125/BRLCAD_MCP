# brlcad-mcp configuration.  Copy to .env and edit.
#
# Blank = use the built-in default, shown below as (default: x).
# A real environment variable overrides this file.  The .env nearest your
# working directory is the one read; the startup banner prints which.
#
# Minimum to run the agent: LLM_API_KEY, plus a listener to talk to.
# The tool path (./evals/run.sh) and the test suite need neither.


# --- 1. Reaching BRL-CAD -----------------------------------------------------
# BRLCAD_IPC_PATH is the transport switch: set = Unix socket, blank = TCP.
# Must match how the listener was started, and must be an ABSOLUTE path
# (a relative one is parsed as a port number and silently becomes TCP).
#
#   mcp_listen 5555  /  mcpcad_test_server 5555 m.g       -> leave blank
#   mcp_listen ipc /tmp/a.sock  /  ...test_server /tmp/a.sock m.g
#                                                         -> set it to that
#   mcp_listen ipc     -> picks /tmp/brlcad-mcp-<pid>.sock and prints it
BRLCAD_IPC_PATH=

# Only used when BRLCAD_IPC_PATH is blank.  Loopback only by design.
BRLCAD_HOST=127.0.0.1
BRLCAD_PORT=5555

# Seconds per command.  Raise to 30-90 if nirt or gqa starts timing out.
BRLCAD_TIMEOUT=5.0

# Socket read chunk size.  No reason to change.
BRLCAD_BUFFER_SIZE=4096


# --- 2. The model ------------------------------------------------------------
# Any LangChain chat backend works -- see docs/PROVIDERS.md.  Set the key and
# the rest can stay blank.
LLM_API_KEY=

# (default: gpt-5.6-sol) Passed through untouched.
LLM_MODEL=

# (default: openai) The WIRE FORMAT, not the vendor: leave it and set
# LLM_BASE_URL for any OpenAI-compatible endpoint (gateway, vLLM, llama.cpp,
# LM Studio, Ollama's /v1).  For a native integration use anthropic |
# google_genai | ollama | azure_openai | bedrock | ... and install its extra,
# e.g.  pip install '.[anthropic]'
LLM_PROVIDER=

# Endpoint override.  Blank = api.openai.com.
LLM_BASE_URL=

# minimal | low | medium | high.  One setting for every backend; each provider
# translates it.  Blank = provider default.
LLM_EFFORT=

# (default: 0) Non-reasoning chat models only; a reasoning model ignores it.
LLM_TEMPERATURE=

# responses | chat.  Blank auto-selects and is almost always right: OpenAI gets
# 'responses', anything with LLM_BASE_URL set gets 'chat'.
LLM_API=

# Extra backend kwargs as JSON, merged last.  e.g. {"num_predict": 512}
LLM_EXTRA=


# --- 3. Verification ---------------------------------------------------------
# Ray verification (bb + nirt).  OFF in this release: nirt is a separate
# executable that fails to start in a plain build tree, so every ray reported
# nothing and that read as "the model is empty".  While off,
# verify_model_dimensions checks existence and bounding box ONLY -- holes,
# pockets and wall thickness are not verified, and it says so in its output.
# Set to 1 once `nirt -h` prints usage in your environment.
BRLCAD_RAY_CHECKS=

# Count a command MGED rejected against the turn's verdict.  Off while ray
# checks are: the agent recovers from those, and a verify PASS used to be what
# cleared them.  A plan error or unreachable listener fails the turn regardless.
VERIFIER_STRICT=


# --- 4. Where files go -------------------------------------------------------
# (default: ~/brlcad_renders) Renders run over the socket; no PATH needed.
BRLCAD_RENDER_DIR=

# (default: 1800) Seconds per render.  Raise for large models or photon mapping.
BRLCAD_RENDER_TIMEOUT=

# (default: ~/brlcad_backups) Restore points for raw destructive commands,
# rolled back with restore_backup.  Kept out of BRLCAD_RENDER_DIR so clearing
# renders cannot delete the only way back from a bad edit.
BRLCAD_BACKUP_DIR=

# (default: beside the database) Where build_from_spec stores the spec it built,
# so verify reads back the spec actually used rather than a resent copy.
BRLCAD_SPEC_DIR=


# --- 5. Running the pieces ---------------------------------------------------
# (default: stdio) How the MCP tool server is reached.
MCP_TRANSPORT=stdio

# Stream a per-node agent trace (routing, model turns, tool calls) in the chat.
# Must be 1/true/yes/on; anything else is false.
CLIENT_V2_DEBUG=false

# Judge model for the eval harness's visual check, pinned separately from the
# worker.  Blank = the worker's model.  Read only by evals/harness.py.
EVAL_JUDGE_MODEL=


# --- 6. Legacy names ---------------------------------------------------------
# Still honoured so an older .env needs no edit, but pure fallbacks: the LLM_*
# equivalent above wins wherever both are set.  Prefer LLM_* in anything new.
# Both endpoint spellings exist because the OpenAI SDK reads OPENAI_BASE_URL
# and langchain-openai reads OPENAI_API_BASE.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_REASONING_EFFORT=
OPENAI_TEMPERATURE=
OPENAI_BASE_URL=
OPENAI_API_BASE=
